#!/bin/bash
${common}  # Insertar los primeros pasos comunes (swap, Docker, wait_for)
log "arrancando RabbitMQ"                                # Contar qué se está haciendo
docker run -d --name central-rabbitmq --hostname central-rabbitmq --restart unless-stopped -p 5672:5672 -p 127.0.0.1:15672:15672 -e RABBITMQ_DEFAULT_USER='${rabbitmq_user}' -e RABBITMQ_DEFAULT_PASS='${rabbitmq_password}' -v rabbitmq-data:/var/lib/rabbitmq rabbitmq:3.13-management-alpine # RabbitMQ: puerto de la cola abierto, panel web solo en localhost (se usa con túnel SSH), nombre de host fijo
log "bootstrap finished OK"                              # Línea de éxito que buscan las verificaciones
