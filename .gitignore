# Local environment: copy .env.example to .env and edit it there.
# The example is committed; the real file never is.
.env

# Python build artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# AWS deployment: the address of the cloud central site, generated by deploy.sh
.env.cloud

# Terraform: local state, provider plugins and the saved plan
infraestructura/.terraform/
infraestructura/*.tfstate
infraestructura/*.tfstate.*
infraestructura/terraform.tfvars
infraestructura/tfplan
